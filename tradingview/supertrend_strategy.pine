//@version=6
strategy("Supertrend Strategy (bot replica)", overlay=true, initial_capital=300,
     default_qty_type=strategy.fixed, default_qty_value=1000, currency=currency.USD,
     commission_type=strategy.commission.cash_per_order, commission_value=0.075,
     process_orders_on_close=true, margin_long=3, margin_short=3, pyramiding=0)

// Backtest version of the Telegram bot. Use on GBPUSD, 1H chart.
// Same rules and numbers as supertrend_bot.py: ATR 13, factor 4.5, RR 1.5,
// entry at the flip candle's close, stop at the Supertrend line, one trade at a time.
// 0.01 lot = 1,000 units. Commission 0.075 per order = about 1.5 pips round trip
// (Settings > Properties > Commission to change).

atrLen   = input.int(13,     "ATR period",        minval=1)
factor   = input.float(4.5,  "Supertrend factor", minval=0.1, step=0.01)
rr       = input.float(1.5,  "Reward : Risk",     minval=0.1, step=0.1)
fromDate = input.time(timestamp("01 Jan 2025 00:00 +0530"), "Backtest from")
showTbl  = input.bool(true,  "Show monthly table")

// ---------- Supertrend ----------
[st, dir] = ta.supertrend(factor, atrLen)          // dir < 0 = uptrend, dir > 0 = downtrend
flipUp = dir < 0 and dir[1] > 0
flipDn = dir > 0 and dir[1] < 0
plot(dir < 0 ? st : na, "Uptrend",   color=color.green, linewidth=2, style=plot.style_linebr)
plot(dir > 0 ? st : na, "Downtrend", color=color.red,   linewidth=2, style=plot.style_linebr)

// ---------- Entries: only when flat (one trade at a time) ----------
if strategy.position_size == 0 and time >= fromDate and (flipUp or flipDn)
    dist = math.abs(close - st)                    // stop distance = close to Supertrend line
    if flipUp
        strategy.entry("BUY", strategy.long)
        strategy.exit("xB", "BUY", stop=close - dist, limit=close + dist * rr)
    else
        strategy.entry("SELL", strategy.short)
        strategy.exit("xS", "SELL", stop=close + dist, limit=close - dist * rr)

// ---------- Monthly results (IST months) ----------
var map<int, float> mP = map.new<int, float>()
var map<int, int>   mN = map.new<int, int>()
var int seen = 0
if strategy.closedtrades > seen
    for i = seen to strategy.closedtrades - 1
        t = strategy.closedtrades.exit_time(i)
        k = year(t, "Asia/Kolkata") * 100 + month(t, "Asia/Kolkata")
        mP.put(k, nz(mP.get(k)) + strategy.closedtrades.profit(i))
        mN.put(k, nz(mN.get(k)) + 1)
    seen := strategy.closedtrades

var table tb = table.new(position.bottom_right, 3, 15, bgcolor=color.new(color.black, 15), border_width=1)
cell(c, r, txt, col) =>
    table.cell(tb, c, r, txt, text_color=col, text_size=size.small)

if showTbl and barstate.islast
    ks  = mP.keys()
    nK  = ks.size()
    pos = 0
    if nK > 0
        for i = 0 to nK - 1
            if mP.get(ks.get(i)) > 0
                pos += 1
    cell(0, 0, "Month",  color.white)
    cell(1, 0, "Trades", color.white)
    cell(2, 0, "P&L $",  color.white)
    r = 1
    if nK > 0
        for i = math.max(0, nK - 12) to nK - 1
            k = ks.get(i)
            p = mP.get(k)
            cell(0, r, str.tostring(k % 100, "00") + "/" + str.tostring(math.floor(k / 100)), color.silver)
            cell(1, r, str.tostring(mN.get(k)), color.white)
            cell(2, r, str.tostring(p, "#.##"), p >= 0 ? color.lime : color.red)
            r += 1
    cell(0, r, "Profit months", color.silver)
    cell(1, r, str.tostring(pos) + " / " + str.tostring(nK), color.white)
    cell(2, r, nK > 0 ? str.tostring(100.0 * pos / nK, "#") + "%" : "-", color.white)
    if timeframe.in_seconds() != 3600
        label.new(bar_index, high, "Switch to the 1H chart", color=color.red, textcolor=color.white)
